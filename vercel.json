{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/host/:ip*",
      "destination": "/api/host?ip=:ip*"
    },
    {
      "source": "/host",
      "destination": "/api/host"
    },
    {
      "source": "/ios/:ip*",
      "destination": "/api/ios?ip=:ip*"
    },
    {
      "source": "/ios",
      "destination": "/api/ios"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/nopy",
      "destination": "/index.html"
    },
    {
      "source": "/nopy/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
